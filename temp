echo "=== INSTANCE GROUPS (managed + unmanaged) ==="
gcloud compute instance-groups managed list
gcloud compute instance-groups list

echo "=== IS backend-ig OUR MIG OR SOMETHING ELSE ==="
gcloud compute instance-groups managed describe backend-ig --zone=me-central2-c --format="yaml(name,instanceTemplate,targetSize,status)"

echo "=== DOES cn-backend-mig EXIST SEPARATELY ==="
gcloud compute instance-groups managed describe cn-backend-mig --region=me-central2 --format="yaml(name,instanceTemplate,targetSize,status)" 2>&1 || echo "cn-backend-mig not found in region me-central2"

echo "=== WHICH INSTANCES BELONG TO backend-ig ==="
gcloud compute instance-groups managed list-instances backend-ig --zone=me-central2-c

echo "=== TEMPLATES ==="
gcloud compute instance-templates list

echo "=== HEALTH CHECKS ==="
gcloud compute health-checks list

echo "=== BACKEND SERVICE DETAIL ==="
gcloud compute backend-services describe app-backend-service --global --format="yaml(portName,protocol,healthChecks,backends)" 2>&1 || \
gcloud compute backend-services describe app-backend-service --region=me-central2 --format="yaml(portName,protocol,healthChecks,backends)"
