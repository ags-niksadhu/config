P=pg-ae-n-app-125609
gcloud logging read "logName=\"projects/$P/logs/backend_pm2_out\" AND jsonPayload.message:\"DDDDDD\"" --project=$P --freshness=12h --limit=1 --format="value(timestamp)"
gcloud logging read 'logName:"logs/backend_" OR logName:"logs/frontend_"' --bucket=cn-staging-logs-me2 --location=me-central2 --view=_AllLogs --project=$P --freshness=30m --limit=10 --format="table(timestamp,logName.basename())"
gcloud logging sinks describe route-to-me2 --project=$P --format="yaml(filter,exclusions,destination,disabled)"
gcloud logging sinks describe _Default --project=$P --format="yaml(filter,exclusions,disabled)"
