echo "=== FIREWALL RULES FOR SSH/IAP ==="
gcloud compute firewall-rules list --format="table(name,network,direction,sourceRanges.list(),allowed[].map().firewall_rule().list(),targetTags.list())"

echo "=== SPECIFICALLY CHECK FOR IAP RANGE 35.235.240.0/20 ==="
gcloud compute firewall-rules list --filter="sourceRanges:35.235.240.0/20"

echo "=== SERIAL PORT LOG — shows actual boot sequence, startup-script output, sshd status ==="
gcloud compute instances get-serial-port-output cn-backend-3h09 --zone=me-central2-c --port=1 > serial-3h09.log
tail -100 serial-3h09.log

echo "=== INSTANCE TEMPLATE METADATA — check if a startup-script exists and what it does ==="
gcloud compute instance-templates describe cn-backend-template-v2 --format="yaml(properties.metadata.items)"

echo "=== NETWORK TAGS ON THE MIG INSTANCE (must match firewall targetTags) ==="
gcloud compute instances describe cn-backend-3h09 --zone=me-central2-c --format="yaml(tags,networkInterfaces)"
