build {
  sources = ["source.googlecompute.frontend"]

  provisioner "shell" {
    inline = [
      "sudo mkdir -p /var/www/careernavigator-frontend",
      "sudo chown $(whoami):$(whoami) /var/www/careernavigator-frontend"
    ]
  }

  provisioner "file" {
    source      = "../dist"
    destination = "/var/www/careernavigator-frontend/dist"
  }
  provisioner "file" {
    source      = "../node_modules"
    destination = "/var/www/careernavigator-frontend/node_modules"
  }
  provisioner "file" {
    source      = "../package.json"
    destination = "/var/www/careernavigator-frontend/package.json"
  }
  provisioner "file" {
    source      = "../package-lock.json"
    destination = "/var/www/careernavigator-frontend/package-lock.json"
  }
  provisioner "file" {
    source      = "../ecosystem.config.js"
    destination = "/var/www/careernavigator-frontend/ecosystem.config.js"
  }

  provisioner "file" {
    source      = "files/careernavigator-frontend.conf"
    destination = "/tmp/careernavigator-frontend.conf"
  }

  provisioner "shell" {
    inline = [
      "curl -fsSL https://deb.nodesource.com/setup_22.x | sudo -E bash -",
      "sudo apt-get install -y nodejs apache2",
      "sudo a2enmod proxy proxy_http headers rewrite ssl http2 remoteip",
      "sudo npm install -g pm2",

      "sudo mv /tmp/careernavigator-frontend.conf /etc/apache2/sites-available/careernavigator-frontend.conf",
      "sudo a2ensite careernavigator-frontend.conf",
      "sudo a2dissite 000-default.conf",

      "sudo systemctl enable apache2",

      "cd /var/www/careernavigator-frontend && pm2 start ecosystem.config.js",
      "sleep 10",

      "echo '=== PM2 STATUS AFTER START ==='",
      "pm2 list",
      "echo \"PM2 running as: $(whoami), home: $HOME\"",

      "pm2 save",
      "ls -la $HOME/.pm2/dump.pm2",
      "sudo env PATH=$PATH:/usr/bin pm2 startup systemd -u $(whoami) --hp $(eval echo ~$(whoami))",

      "echo '=== VERIFYING /health ==='",
      "for i in 1 2 3 4 5 6; do curl -sf http://localhost:3027/health > /dev/null && echo 'APP IS UP' && break || (echo \"attempt $i failed, retrying...\" && sleep 5); done",
      "curl -sf http://localhost:3027/health > /dev/null || (echo 'FATAL: /health did not respond after 30s - failing build' && pm2 logs careernavigator-frontend --lines 100 --nostream && exit 1)"
    ]
  }
}
