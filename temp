steps:
  - id: Install Dependencies
    name: 'node:22'
    entrypoint: npm
    args: ['ci']

  - id: Run Tests
    name: 'node:22'
    entrypoint: npm
    args:
      - run
      - test
      - --
      - --passWithNoTests

  - id: Build Staging
    name: 'node:22'
    entrypoint: npm
    args: ['run', 'build']

  - id: Build Packer Image
    name: 'hashicorp/packer:latest'
    entrypoint: sh
    args:
      - -c
      - |
        cd packer
        packer init .
        packer build -var="commit_sha=$SHORT_SHA" .

  - id: Create Instance Template
    name: 'gcr.io/cloud-builders/gcloud'
    entrypoint: bash
    args:
      - -c
      - |
        gcloud compute instance-templates create cn-frontend-template-$SHORT_SHA \
          --project=pg-ae-n-app-125609 \
          --region=me-central2 \
          --machine-type=e2-medium \
          --image=cn-frontend-image-$SHORT_SHA \
          --network=default \
          --subnet=default \
          --no-address \
          --scopes=cloud-platform \
          --tags=cn-frontend \
          --shielded-secure-boot \
          --shielded-vtpm \
          --shielded-integrity-monitoring \
          --labels=managed-by=cloudbuild-packer,app=cn-frontend

  - id: Rolling Update MIG
    name: 'gcr.io/cloud-builders/gcloud'
    entrypoint: bash
    args:
      - -c
      - |
        gcloud compute instance-groups managed rolling-action start-update cn-frontend-mig-regional \
          --project=pg-ae-n-app-125609 \
          --region=me-central2 \
          --version=template=cn-frontend-template-$SHORT_SHA \
          --max-surge=3 \
          --max-unavailable=0

  - id: Verify Rollout Health
    name: 'gcr.io/cloud-builders/gcloud'
    entrypoint: bash
    args:
      - -c
      - |
        gcloud compute instance-groups managed wait-until cn-frontend-mig-regional \
          --project=pg-ae-n-app-125609 \
          --region=me-central2 \
          --stable \
          --timeout=1800

  - id: Cleanup Old Packer Artifacts
    name: 'gcr.io/cloud-builders/gcloud'
    entrypoint: bash
    args:
      - -c
      - |
        # Deletes ONLY labeled pipeline-created templates/images beyond the newest KEEP.
        # DRY_RUN=1 prints only. Set DRY_RUN=0 after reviewing a dry-run log.
        KEEP=5
        DRY_RUN=1
        PROJECT=pg-ae-n-app-125609
        IN_USE=$$(gcloud compute instance-groups managed describe cn-frontend-mig-regional --region=me-central2 --project=$$PROJECT --format="value(versions[].instanceTemplate.basename())")
        gcloud compute instance-templates list --project=$$PROJECT \
          --filter="labels.managed-by=cloudbuild-packer AND labels.app=cn-frontend AND name~^cn-frontend-template-[0-9a-f]{7}$$" \
          --sort-by=~creationTimestamp --format="value(name)" | tail -n +$$((KEEP+1)) | while read T; do
            if echo "$$IN_USE" | grep -qw "$$T"; then echo "SKIP in use: $$T"; continue; fi
            SHA=$${T#cn-frontend-template-}
            IMG=$$(gcloud compute images list --project=$$PROJECT --filter="name=cn-frontend-image-$$SHA AND labels.managed-by=cloudbuild-packer" --format="value(name)")
            if [ "$$DRY_RUN" = "1" ]; then
              echo "DRY RUN would delete template $$T and image $${IMG:-none}"
            else
              gcloud compute instance-templates delete "$$T" --project=$$PROJECT --quiet
              if [ -n "$$IMG" ]; then gcloud compute images delete "$$IMG" --project=$$PROJECT --quiet; fi
            fi
          done
        exit 0

