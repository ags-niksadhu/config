echo "=== TRIGGER LIST ==="
gcloud builds triggers list

echo "=== TRIGGER DETAIL (branch filter, repo, included files) ==="
gcloud builds triggers describe TRIGGER_NAME --format="yaml(triggerTemplate,github,substitutions,filename,includedFiles)"
# ⬅ replace TRIGGER_NAME with the actual name from the list above

echo "=== RECENT BUILD HISTORY — has it ever actually run? ==="
gcloud builds list --limit=10 --format="table(id,status,createTime,substitutions.SHORT_SHA)"

echo "=== BIGQUERY TABLE CHECK ==="
bq show deployments.deployment_history 2>&1

echo "=== CONFIRM cloudbuild.yaml IS ON THE PUSHED BRANCH ==="
git log --oneline -5
git branch --show-current
