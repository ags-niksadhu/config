I still don't know `SECRET_LOCATION`, because the `ecosystem.config.js` output wasn't in your paste. Instead of guessing, this script reads those settings from `ecosystem.config.js`, calls the app's own `loadSecrets()` and runs `migration:show` in the same process. It's read-only. It uses the VM's `sa-cn-backend` identity, writes no secrets to disk and prints no values.

```bash
cat > /tmp/mig.js <<'EOF'
const path = '/var/www/careernavigator-backend';
process.chdir(path);
const app = require(path + '/ecosystem.config.js').apps[0];
const e = { ...(app.env || {}), ...(app.env_staging || {}) };
for (const k of ['GCP_PROJECT_ID', 'SECRET_PREFIX', 'SECRET_LOCATION']) {
  if (e[k] !== undefined) process.env[k] = String(e[k]);
}
process.env.NODE_ENV = 'staging';
console.log('location =', process.env.SECRET_LOCATION || '(global)', '| prefix =', process.env.SECRET_PREFIX || '(default)');
const { loadSecrets } = require(path + '/dist/common/config/secret-manager.js');
loadSecrets().then(() => {
  const r = require('child_process').spawnSync(
    path + '/node_modules/.bin/typeorm',
    ['migration:show', '-d', 'dist/data-source.js'],
    { stdio: 'inherit', env: process.env });
  process.exit(r.status ?? 1);
}).catch((err) => { console.error(err.message); process.exit(1); });
EOF
node /tmp/mig.js; rm -f /tmp/mig.js
```

