  "desc": "(az-207) Ensures that Application Gateways are configured without a public frontend IP address. Its purpose is to enforce the use of private-only Application Gateways, enhancing network security by preventing exposure to the public internet.",
  "rule": {
    "if": {
      "allOf": [
        {
          "equals": "Microsoft.Network/applicationGateways",
          "field": "type"
        },
        {
          "count": {
            "field": "Microsoft.Network/applicationGateways/frontendIPConfigurations[*]",
            "where": {
              "exists": true,
              "field": "Microsoft.Network/applicationGateways/frontendIPConfigurations[*].publicIPAddress.id"
            }
          },
          "greater": 0
        }
      ]
    },
    "then": {
      "effect": "[parameters('effect')]"
    }
  }
}
